{
  "name": "@levibostian/mock-a-bin",
  "exports": "./main.ts",
  "publish": {
    "include": [
      "README.md",
      "LICENSE",
      "main.ts"
    ]
  },
  "tasks": {
    "test": "deno test --allow-all --clean --junit-path reports/junit.xml --coverage=reports/coverage/",
    "format": "deno fmt",
    "lint": "deno fmt && deno lint --fix"
  },
  "fmt": {
    "lineWidth": 150,
    "semiColons": false,
    "include": ["**/*.ts"],
    "exclude": ["**/*.json", "**/*.md", "**/*.yml", "**/*.yml", "**/*.lock"]
  },
  "lint": {
    "rules": {
      "exclude": ["require-await"]
    }
  },
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  }
}
